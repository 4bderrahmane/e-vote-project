<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/welcome_bg"
        android:clipChildren="false"
        android:clipToPadding="false">

    <View
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-100dp"
            android:layout_marginTop="-100dp"
            android:alpha="0.16"
            android:background="@drawable/welcome_shape_primary" />

    <View
            android:layout_width="380dp"
            android:layout_height="380dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-140dp"
            android:layout_marginBottom="-140dp"
            android:alpha="0.14"
            android:background="@drawable/welcome_shape_secondary" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="680dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="40dp"
                android:paddingEnd="24dp"
                android:paddingBottom="40dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/welcome_card_bg"
                    android:elevation="16dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="40dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="36dp">

                <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginBottom="28dp"
                        android:background="@drawable/welcome_icon_bg"
                        android:elevation="4dp">

                    <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_vote_48" />
                </FrameLayout>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/welcome_title"
                        android:textColor="@color/welcome_text"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/welcome_highlight"
                        android:textColor="@color/welcome_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="36dp"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:text="@string/welcome_description"
                        android:textColor="@color/welcome_muted"
                        android:textSize="16sp" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <TextView
                            android:id="@+id/btnCreateAccount"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/welcome_primary_button_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="@string/welcome_create_account"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/btnLogin"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/welcome_outline_button_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="@string/welcome_login"
                            android:textColor="@color/welcome_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
