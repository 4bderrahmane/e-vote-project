<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/welcome_bg"
        android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="14dp">

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_election"
                    android:textColor="@color/welcome_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Create elections and parties"
                    android:textColor="@color/welcome_muted"
                    android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_surface_bg"
                android:orientation="horizontal"
                android:padding="6dp">

            <TextView
                    android:id="@+id/btnElectionMode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/welcome_primary_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Election"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/btnPartyMode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/welcome_outline_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Party"
                    android:textColor="@color/welcome_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/electionForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface_bg"
                android:orientation="vertical"
                android:padding="18dp">

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Title"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputElectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Description"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputElectionDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Start (YYYY-MM-DD HH:mm)"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputElectionStart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="End (YYYY-MM-DD HH:mm)"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputElectionEnd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Phase (REGISTRATION, VOTING, or TALLY)"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputElectionPhase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Encryption public key (32 bytes hex)"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputElectionPublicKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                    android:id="@+id/btnCreateElection"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/welcome_primary_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Create Election"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/partyForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface_bg"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Party name"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPartyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Abbreviation"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPartyAbbreviation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Description"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPartyDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Member CINs (comma-separated)"
                    style="@style/Privote.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPartyMemberCins"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/welcome_text"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                    android:id="@+id/btnCreateParty"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/welcome_primary_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Create Party"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
        </LinearLayout>

        <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/welcome_muted"
                android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
