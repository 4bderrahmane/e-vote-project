<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/welcome_bg"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/welcome_outline_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/back"
                    android:textColor="@color/welcome_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/welcome_line"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/welcome_text"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/tvPhase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/chip_neutral_bg"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:textColor="@color/welcome_brand"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/welcome_muted"
                            android:textSize="15sp" />

                    <TextView
                            android:id="@+id/tvDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/page_placeholder_bg"
                            android:lineSpacingExtra="5dp"
                            android:padding="12dp"
                            android:textColor="@color/welcome_text"
                            android:textSize="14sp" />

                    <TextView
                            android:id="@+id/btnStartElection"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/welcome_primary_button_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/start_voting_button"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    <TextView
                            android:id="@+id/tvAdminMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/welcome_muted"
                            android:textSize="13sp"
                            android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                    android:id="@+id/registerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_surface_bg"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/register_section_title"
                        android:textColor="@color/welcome_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/tvRegisterStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/chip_neutral_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="@string/register_status_not_registered"
                        android:textColor="@color/welcome_brand"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/tvRegisterIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/register_intro"
                        android:textColor="@color/welcome_muted"
                        android:textSize="14sp" />

                <EditText
                        android:id="@+id/inputRegisterPassphrase"
                        style="@style/PrivoteEditText"
                        android:layout_marginTop="12dp"
                        android:hint="@string/register_passphrase_hint"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                <TextView
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/welcome_primary_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="@string/register_button"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/tvRegisterMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/welcome_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/voteCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_surface_bg"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vote_section_title"
                        android:textColor="@color/welcome_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/tvVoteIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/vote_intro"
                        android:textColor="@color/welcome_muted"
                        android:textSize="14sp" />

                <TextView
                        android:id="@+id/tvVoteWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/page_placeholder_bg"
                        android:padding="12dp"
                        android:text="@string/vote_unencrypted_warning"
                        android:textColor="@color/welcome_brand"
                        android:textSize="13sp" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/vote_candidates_label"
                        android:textColor="@color/welcome_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerCandidates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false" />

                <TextView
                        android:id="@+id/tvCandidatesEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/welcome_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />

                <EditText
                        android:id="@+id/inputVotePassphrase"
                        style="@style/PrivoteEditText"
                        android:layout_marginTop="14dp"
                        android:hint="@string/vote_passphrase_hint"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                <TextView
                        android:id="@+id/btnCastVote"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/welcome_primary_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="@string/vote_button"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/tvVoteMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/welcome_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />
            </LinearLayout>

            <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/welcome_muted"
                    android:textSize="15sp"
                    android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
