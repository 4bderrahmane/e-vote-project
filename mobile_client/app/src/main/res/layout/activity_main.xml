<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/welcome_bg"
        android:orientation="vertical">

    <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/white"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

        <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/app_brand_mark_bg">

            <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_vote_48" />
        </FrameLayout>

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="privote"
                android:textColor="@color/welcome_text"
                android:textSize="20sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/btnRoleSwitch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chip_neutral_bg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/welcome_brand"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

        <ImageButton
                android:id="@+id/btnLogout"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/logout"
                android:padding="10dp"
                android:src="@drawable/ic_logout_24" />
    </LinearLayout>

    <FrameLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:elevation="8dp"
            app:itemActiveIndicatorStyle="@style/Widget.Privote.BottomNavigation.ActiveIndicator"
            app:itemIconTint="@color/bottom_nav_item_color"
            app:itemTextColor="@color/bottom_nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/main_bottom_nav" />
</LinearLayout>
